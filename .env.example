# Copy to .env and fill in. Every key is optional: without it the server uses demo data.
ANTHROPIC_API_KEY=
CLAUDE_MODEL_FAST=claude-haiku-5-5
CLAUDE_MODEL_SMART=claude-sonnet-5-5

# Capital One Nessie (http://api.nessieisreal.com)
NESSIE_API_KEY=
NESSIE_CUSTOMER_ID=

# Google Places, for the location stretch goal
GOOGLE_PLACES_KEY=

PORT=5001
# 1 turns on Flask debug + auto-reloader (a reload wipes Debt Guard and approvals).
FLASK_DEBUG=0

# --- agents/ (Fetch.ai Pocket Pilot team: pocket_pilot_agent.py is the only
# one users chat with; card_scorer_agent.py, payment_planner_agent.py, and
# merchant_resolver_agent.py are specialists it delegates to over agent-to-
# agent messages -- Card Scorer also asks Merchant Resolver on its own
# before every pick) ---
# Where every agent finds the Flask API from CLAUDE.md's server/.
POCKET_PILOT_API_URL=http://localhost:5001

# Each agent's seed is a deterministic secret string: it keeps that agent's
# address stable across restarts, and -- since an agent's address is derived
# from its seed -- lets Pocket Pilot (and Card Scorer, for the Resolver)
# compute specialist addresses itself instead of needing separate *_ADDRESS
# vars. Every seed is required: an agent (and run_all.py) refuses to start
# without its seed. Use a different long random string for each.
POCKET_PILOT_SEED=
POCKET_PILOT_PORT=8001
CARD_SCORER_SEED=
CARD_SCORER_PORT=8002
PAYMENT_PLANNER_SEED=
PAYMENT_PLANNER_PORT=8003
MERCHANT_RESOLVER_SEED=
MERCHANT_RESOLVER_PORT=8004

# on (default): our four agents reach each other at http://127.0.0.1:<port>/submit,
# found from the seeds + ports above, instead of asking the Almanac API (which
# times out on slow Wi-Fi). Pocket Pilot keeps its mailbox for ASI:One either
# way. off: every hop goes through Agentverse, as before.
LOCAL_AGENT_ROUTING=on

# "reset demo" in chat wipes approvals and settings. Only works when on.
DEMO_MODE=off

# Reused from above: only needed if you want the optional LLM intent-parsing
# fallback in agents/intents.py (deterministic parsing works without it).
# ANTHROPIC_API_KEY=

# --- Coinbase x402 (agents/x402_*.py). TEST NETWORK ONLY, never real money. ---
# All three CDP keys (https://portal.cdp.coinbase.com -> API Keys / Server
# Wallet) turn x402 on. Leave any one empty and x402 is simply off: every
# agent works exactly as before. Never commit real values.
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
CDP_WALLET_SECRET=
# on (default when the keys are set) / off
X402_ENABLED=on
# Must be a testnet. Only Base Sepolia (eip155:84532) is allowed; anything
# else and the x402 service, the paying resolver and the demo refuse to start.
X402_NETWORK=eip155:84532
# Public x402 facilitator (no key needed; verifies + settles on Base Sepolia).
X402_FACILITATOR_URL=https://x402.org/facilitator
# Our paid endpoints (agents/x402_server.py).
X402_PORT=8010
X402_SERVER_URL=http://127.0.0.1:8010
X402_PRICE_BEST_CARD_USD=0.001
X402_PRICE_MERCHANT_DATA_USD=0.001
# Hard limits for the paying wallet (Merchant Resolver). Over either -> it
# doesn't pay, keeps its free answer, and logs why.
X402_DAILY_CAP_USD=0.05
X402_MAX_PER_CALL_USD=0.01
# Optional: receive earnings at this address instead of the CDP seller account.
# X402_PAY_TO=0x...
