# Copy to .env and fill in. Every key is optional: without it the server uses demo data.
ANTHROPIC_API_KEY=
CLAUDE_MODEL_FAST=claude-haiku-5-5
CLAUDE_MODEL_SMART=claude-sonnet-5-5

# Capital One Nessie (http://api.nessieisreal.com)
NESSIE_API_KEY=
NESSIE_CUSTOMER_ID=

# Google Places, for the location stretch goal
GOOGLE_PLACES_KEY=

PORT=5001
# 1 turns on Flask debug + auto-reloader (a reload wipes Debt Guard and approvals).
FLASK_DEBUG=0

# --- agents/ (Fetch.ai Pocket Pilot team: pocket_pilot_agent.py is the only
# one users chat with; card_scorer_agent.py, payment_planner_agent.py, and
# merchant_resolver_agent.py are specialists it delegates to over agent-to-
# agent messages -- Card Scorer also asks Merchant Resolver on its own
# before every pick) ---
# Where every agent finds the Flask API from CLAUDE.md's server/.
POCKET_PILOT_API_URL=http://localhost:5001

# Each agent's seed is a deterministic secret string: it keeps that agent's
# address stable across restarts, and -- since an agent's address is derived
# from its seed -- lets Pocket Pilot (and Card Scorer, for the Resolver)
# compute specialist addresses itself instead of needing separate *_ADDRESS
# vars. Every seed is required: an agent (and run_all.py) refuses to start
# without its seed. Use a different long random string for each.
POCKET_PILOT_SEED=
POCKET_PILOT_PORT=8001
CARD_SCORER_SEED=
CARD_SCORER_PORT=8002
PAYMENT_PLANNER_SEED=
PAYMENT_PLANNER_PORT=8003
MERCHANT_RESOLVER_SEED=
MERCHANT_RESOLVER_PORT=8004

# "reset demo" in chat wipes approvals and settings. Only works when on.
DEMO_MODE=off

# Reused from above: only needed if you want the optional LLM intent-parsing
# fallback in agents/intents.py (deterministic parsing works without it).
# ANTHROPIC_API_KEY=
